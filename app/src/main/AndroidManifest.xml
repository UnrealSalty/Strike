<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- DiCarServer requires declared BYD permissions even for getters. -->
    <uses-permission android:name="android.permission.BYD" />
    <uses-permission android:name="com.byd.car.server.PROVIDER" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_OTA_GET" />
    <uses-permission android:name="android.permission.BYD_CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".StrikeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Strike"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".BootCompleted" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".RecorderRevival"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".DiLink5NetworkReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".RecorderRecoveryService"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".BootRecovery"
            android:directBootAware="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <service
            android:name=".RecorderRevivalJob"
            android:directBootAware="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <service
            android:name=".BootStart"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/boot_start" />
        </service>

        <receiver android:name=".recording.AccOff" android:exported="true">
            <intent-filter>
                <action android:name="com.byd.action.ACC_OFF" />
            </intent-filter>
        </receiver>

        <receiver android:name=".recording.AccOn" android:exported="true">
            <intent-filter>
                <action android:name="com.byd.action.ACC_ON" />
                <action android:name="com.byd.action.IGN_ON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
